{
  "juggernaut-primary": {
    "SessionStart": [
      {
        "type": "command",
        "command": "exec ../bin/jg-sessionstart-agy.sh",
        "timeout": 180
      }
    ],
    "PreToolUse": [
      {
        "matcher": "run_command",
        "hooks": [
          {
            "type": "command",
            "command": "exec ../bin/jg-arm-pretool-check.sh --agy",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "exec ../bin/jg-turnend-guard-agy.sh",
        "timeout": 60
      }
    ]
  }
}
