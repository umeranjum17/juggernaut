#!/usr/bin/env bash
# juggernaut-axi - bounded, read-only fleet facts for external tools (AXI style).
#
# The approved design (data/juggernaut-axi/report.md), read-only commands so far:
# `status`, `lanes`, `wakes`, `tickets`, `tasks` (list, show, ready), `holds`, `pr`, `decisions`, `messages`,
# plus the three writes `answer`, `message`, and `ticket`, each delegated to an existing
# guarded path (jg-captain-hold.sh, jg-send.sh, jg-tasks-axi.sh); it never closes tasks
# or writes state itself, and a result claims only what the durable record confirms. Like bin/jg-bearings-snapshot.sh it projects the canonical JSON model
# (jg-bearings-snapshot.sh / jg-fleet-snapshot.sh --json) and renders TOON at the
# output boundary (bin/jg-toon-lib.sh); `--json` prints the same model.
# Output contract: `juggernaut-axi.v1`; consumers ignore unknown fields.
# It never writes state, never reads task transcripts, and states every omission.
# Conventions follow the backlog: `count: N of M total`, tabular rows, a plain-words empty
# state, cut text that names its full length (`--full` lifts it), `--fields` for extra
# columns, `--limit`, a trailing help[] of next steps, and `<command> --help`.
# `lanes` projects jg-fleet-snapshot.sh --json; `wakes` opens the bus read model
# (state/.wake-queue, state/.wake-settled) as it is and never renders, acknowledges, or
# calls the bus, so its age is stated and nothing it does moves a wake.
# `tasks` and `holds` project the backlog records of the same fleet snapshot (no new store):
# `tasks ready` is queued work with no unresolved blocker and no hold, as `jg-tasks-axi.sh ready` is.
# `pr <url>` runs bin/jg-pr-state.sh (read-only) for the blockers it can see and the one thing
# the change waits for; an empty blocker list is not a readiness verdict, and the output says so.
set -u

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=bin/jg-toon-lib.sh
# shellcheck disable=SC1091
. "$SCRIPT_DIR/jg-toon-lib.sh"
# shellcheck source=bin/jg-task-inbox-lib.sh
# shellcheck disable=SC1091
. "$SCRIPT_DIR/jg-task-inbox-lib.sh"

VERSION=0.3.0
TICKETS_MAX=100
LANES_FIELDS="harness backend branch mode yolo pr age_seconds detail endpoint freshness"
TASKS_FIELDS="priority since blocked_by hold_kind hold_reason hold_until pr links"
MESSAGE_BYTES=8192
HOME_ROOT=$(cd "$SCRIPT_DIR/.." && pwd)
STATE=${JG_STATE_OVERRIDE:-${JG_HOME:-$(cd "$SCRIPT_DIR/.." && pwd)}/state}

usage() {
  cat <<'USAGE'
usage: juggernaut-axi <command> [--json]
       juggernaut-axi --help | --version

commands:
  status                 bounded current fleet projection
  lanes [--state <s>] [--kind <k>] [--project <name>] [--limit <n>] [--fields <a,b>] [--full]
                         one row per worker lane (default 50, at most 100)
  wakes [--kind <k>] [--limit <n>] [--full]
                         queued wakes from the bus read model, oldest first
  tasks [list] [--state <queued|in_flight|done|held>] [--repo <name>] [--kind <k>] [--blocked]
        [--limit <n>] [--fields <a,b>] [--full]
                         backlog rows in the backlog's shape (default 50, at most 100)
  tasks show <id> [--full]
                         one task with its hold, blockers, links, and notes
  tasks ready [--repo <name>] [--limit <n>] [--full]
                         queued work with no unresolved blocker and no hold
  holds [--kind <captain|future|parked|external>] [--bucket <live|dated|aged|blocked>]
        [--limit <n>] [--full]
                         every held task, with its hold kind, reason, and age
  pr <github-pr-url>     the blockers one pull request shows now, and what it waits for
                         (read-only; asks GitHub at the time you run it)
  tickets [--state <queued|in_flight|done>] [--repo <name>] [--limit <n>]
                         bounded backlog rows (default 50, at most 100)
  decisions              open captain holds (read-only; answering is a later slice)
  messages <task-id> [--limit <n>]
                         newest steering messages for one known task (default 20,
                         at most 100; bodies cut at 8 KiB)
  answer <task-id> <answer> [--release]
                         record the captain's answer to an open decision
  message <task-id> <text>
                         append a steering message to one known task (text of
                         at most 8 KiB, not starting with / or $)
  ticket <title> --why <text> [--repo <name>] [--kind <ship|scout|docs>] [--priority <0-3>]
                         queue a new ticket (never starts work); the title starts
                         with a type tag and --why says why it is worth doing
                         (bin/jg-tasks-axi.sh owns that intake rule)

  serve [--port <n>] [--reads-per-minute <n>]
                         opt-in loopback (127.0.0.1) read-only HTTP API; needs an
                         owner-only token in config/juggernaut-axi-token

TOON by default; --json prints the same versioned model (juggernaut-axi.v1).
Errors go to stderr with a nonzero exit. Omitted rows are counted in omitted[].
USAGE
}

die() { echo "juggernaut-axi: $*" >&2; exit 2; }

# Per-command help in the backlog's shape: usage, flags, examples.
verb_help() {
  case "$1" in
    lanes) cat <<'HELP'
usage: juggernaut-axi lanes [flags]
flags:
  --state <s>, --kind <k>, --project <name>, --limit <n> (default 50, at most 100), --full
  --fields <a,b,c>  (extra: harness, backend, branch, mode, yolo, pr, age_seconds, detail, endpoint, freshness)
examples:
  juggernaut-axi lanes --state working
  juggernaut-axi lanes --project juggernaut --fields branch,pr
HELP
    ;;
    wakes) cat <<'HELP'
usage: juggernaut-axi wakes [flags]
flags:
  --kind <signal|stale|check|heartbeat>, --limit <n> (default 50, at most 100), --full
examples:
  juggernaut-axi wakes
  juggernaut-axi wakes --kind stale --full
HELP
    ;;
    tasks) cat <<'HELP'
usage: juggernaut-axi tasks [list] [flags]
       juggernaut-axi tasks show <id> [--full]
       juggernaut-axi tasks ready [--repo <name>] [--limit <n>] [--full]
flags (list):
  --state <queued|in_flight|done|held>, --repo <name>, --kind <name>, --blocked
  --limit <n> (default 50, at most 100), --full
  --fields <a,b,c>  (extra: priority, since, blocked_by, hold_kind, hold_reason, hold_until, pr, links)
examples:
  juggernaut-axi tasks --state queued --repo juggernaut
  juggernaut-axi tasks show some-task-id --full
  juggernaut-axi tasks ready
HELP
    ;;
    holds) cat <<'HELP'
usage: juggernaut-axi holds [flags]
flags:
  --kind <captain|future|parked|external>, --bucket <live|dated|aged|blocked> (captain holds only)
  --limit <n> (default 50, at most 100), --full
example: juggernaut-axi holds --kind captain
HELP
    ;;
    pr) cat <<'HELP'
usage: juggernaut-axi pr <https://github.com/owner/repo/pull/N>
Reads GitHub now. No blocker listed does not mean ready: an unreported required check is not listed.
HELP
    ;;
    *) usage ;;
  esac
}

# TOON-only presentation, the backlog style: "count: N of M total" and a plain-words empty list.
# shellcheck disable=SC2016
TOON_PREP='
  (if .view == "lanes" and (.lanes | length) == 0 then .lanes = "0 lanes match these filters"
   elif .view == "wakes" and (.wakes | length) == 0 then .wakes = "0 wakes queued"
   elif .view == "tasks" and (.tasks | length) == 0 then .tasks = "0 tasks match these filters"
   elif .view == "ready" and (.ready | length) == 0 then .ready = "0 tasks are ready"
   elif .view == "holds" and (.holds | length) == 0 then .holds = "0 holds match these filters"
   elif .view == "pr" and (.blockers | length) == 0 then .blockers = "0 blockers reported"
   else . end)
  | if has("total") then .count = "\(.count) of \(.total) total" | del(.total) else . end'

jq_or_die() {  # <what> <jq args...> - reads the model on stdin
  local what=$1; shift
  jq "$@" || { echo "juggernaut-axi: $what projection failed" >&2; exit 1; }
}

cmd_status() {
  local snap
  snap=$("$SCRIPT_DIR/jg-bearings-snapshot.sh" --json) || { echo "juggernaut-axi: fleet snapshot failed" >&2; exit 1; }
  printf '%s\n' "$snap" | jq_or_die status --argjson wakes "$(wake_rows | grep -c . || true)" '{
    schema: "juggernaut-axi.v1", view: "status", home, generated,
    counts: {in_flight: (.in_flight | length), decisions_open: (.decisions_open | length),
             squad_leads: (.squad_leads | length), gates: (.gates | length), wakes_queued: $wakes,
             lanes_by_state: (reduce .in_flight[] as $r ({}; .[$r.state] += 1))},
    in_flight: [.in_flight[] | {id, kind, state, repo, name, doing}],
    omitted: .omitted,
    help: ["Run `juggernaut-axi lanes` for one row per worker lane",
           "Run `juggernaut-axi wakes` for the queued wakes",
           "Run `juggernaut-axi decisions` for the open captain holds"]}'
}

wake_rows() {  # the queued rows of the bus read model, oldest first; nothing when it is absent
  [ -f "$STATE/.wake-queue" ] || return 0
  awk -F '\t' 'NF >= 5' "$STATE/.wake-queue"
}

limit_arg() {  # <value> -> the value capped at TICKETS_MAX, or exit 2
  case "$1" in ''|*[!0-9]*|0) die "--limit must be a positive integer" ;; esac
  [ "$1" -le "$TICKETS_MAX" ] && printf '%s' "$1" || printf '%s' "$TICKETS_MAX"
}

cmd_lanes() {
  local state="" kind="" project="" limit=50 fields="" full=false
  while [ $# -gt 0 ]; do
    case "$1" in
      --state) [ $# -ge 2 ] || die "--state needs a value"; state=$2; shift ;;
      --kind) [ $# -ge 2 ] || die "--kind needs a value"; kind=$2; shift ;;
      --project) [ $# -ge 2 ] || die "--project needs a value"; project=$2; shift ;;
      --limit) [ $# -ge 2 ] || die "--limit needs a value"; limit=$(limit_arg "$2") || exit $?; shift ;;
      --fields) [ $# -ge 2 ] || die "--fields needs a value"; fields=$2; shift ;;
      --full) full=true ;;
      *) die "unknown lanes argument: $1" ;;
    esac
    shift
  done
  local f
  for f in ${fields//,/ }; do
    case " $LANES_FIELDS " in *" $f "*) ;; *) die "unknown --fields name: $f (extra: ${LANES_FIELDS// /, })" ;; esac
  done
  local snap
  snap=$("$SCRIPT_DIR/jg-fleet-snapshot.sh" --json) || { echo "juggernaut-axi: fleet snapshot failed" >&2; exit 1; }
  printf '%s\n' "$snap" | jq_or_die lanes --arg state "$state" --arg kind "$kind" --arg project "$project" \
    --argjson limit "$limit" --arg fields "$fields" --argjson full "$full" '
    def dash: if . == null or . == "" then "-" else . end;
    def cut: tostring | length as $n
      | if ($full | not) and $n > 100 then .[:100] + "... (truncated, \($n) chars total - use --full)" else . end;
    def cell($name): {
      harness: (.harness // "-"), backend: (.backend // "-"), branch: (.branch // "-"),
      mode: (.mode // "-"), yolo: (.yolo // "-"), pr: (.pr.url // "-"),
      age_seconds: (.paths.status_log.last_event.age_seconds // "-"),
      detail: ((.current_state.detail // "-") | cut), endpoint: (.endpoint.status // "-"),
      freshness: (.current_state.freshness // "-")}[$name];
    ($fields | split(",") | map(select(. != ""))) as $extra
    | [.tasks[] | select($state == "" or .current_state.state == $state)
                | select($kind == "" or .kind == $kind)
                | select($project == "" or ((.project // "") | split("/") | last) == $project)] as $all
    | {schema: "juggernaut-axi.v1", view: "lanes", home: (.jg_home | split("/") | .[-2:] | join("/")), generated,
       count: ($all[:$limit] | length), total: ($all | length),
       lanes: [$all[:$limit][] | . as $t
         | {id, kind, state: (.current_state.state // "unknown"),
            reported: (.paths.status_log.last_event.state | dash),
            project: ((.project // "-") | split("/") | last),
            note: ((.paths.status_log.last_event.note | dash) | cut)}
         + ([$extra[] | . as $n | {key: $n, value: ($t | cell($n))}] | from_entries)],
       omitted: (if ($all | length) > $limit then [{surface: "lanes beyond limit", count: (($all | length) - $limit), reveal: "--limit <n> (at most 100)"}] else [] end),
       help: ["Run `juggernaut-axi lanes --fields harness,branch,pr` for more columns",
              "Run `juggernaut-axi messages <id>` for a lane'"'"'s steering records"]}'
}

cmd_wakes() {
  local kind="" limit=50 full=false
  while [ $# -gt 0 ]; do
    case "$1" in
      --kind) [ $# -ge 2 ] || die "--kind needs a value"; kind=$2; shift ;;
      --limit) [ $# -ge 2 ] || die "--limit needs a value"; limit=$(limit_arg "$2") || exit $?; shift ;;
      --full) full=true ;;
      *) die "unknown wakes argument: $1" ;;
    esac
    shift
  done
  case "$kind" in ''|signal|stale|check|heartbeat) ;; *) die "--kind must be signal, stale, check, or heartbeat" ;; esac
  local age="null" settled=0 mt
  if mt=$(stat -c %Y "$STATE/.wake-queue" 2>/dev/null || stat -f %m "$STATE/.wake-queue" 2>/dev/null); then
    age=$(( $(date +%s) - mt ))
  fi
  [ -f "$STATE/.wake-settled" ] && settled=$(grep -c . "$STATE/.wake-settled" || true)
  wake_rows | jq_or_die wakes -R -s --arg kind "$kind" --argjson limit "$limit" --argjson full "$full" \
    --argjson age "$age" --argjson settled "$settled" '
    def cut: length as $n
      | if ($full | not) and $n > 160 then .[:160] + "... (truncated, \($n) chars total - use --full)" else . end;
    [split("\n")[] | select(. != "") | split("\t")
      | {seq: (.[1] | tonumber? // .[1]), at: (.[0] | tonumber? // 0 | todate), kind: .[2], key: .[3], payload: (.[4:] | join(" ") | cut)}
      | select($kind == "" or .kind == $kind)] as $all
    | {schema: "juggernaut-axi.v1", view: "wakes", source: "bus read model (state/.wake-queue), not the live bus", queued: ($all | length),
       count: ($all[:$limit] | length), total: ($all | length),
       kinds: ($all | group_by(.kind) | map({kind: .[0].kind, count: length})),
       wakes: $all[:$limit],
       settled_recorded: $settled, read_model_age_seconds: $age,
       omitted: (if ($all | length) > $limit then [{surface: "wakes beyond limit", count: (($all | length) - $limit), reveal: "--limit <n> (at most 100)"}] else [] end),
       help: ["Run `juggernaut-axi lanes` for the workers these wakes come from",
              "A wake leaves the queue only when the supervising session acknowledges it"]}'
}

cmd_tickets() {
  local state="" repo="" limit=50
  while [ $# -gt 0 ]; do
    case "$1" in
      --state) [ $# -ge 2 ] || die "--state needs a value"; state=$2; shift ;;
      --repo) [ $# -ge 2 ] || die "--repo needs a value"; repo=$2; shift ;;
      --limit) [ $# -ge 2 ] || die "--limit needs a value"; limit=$2; shift ;;
      *) die "unknown tickets argument: $1" ;;
    esac
    shift
  done
  case "$state" in ''|queued|in_flight|done) ;; *) die "--state must be queued, in_flight, or done" ;; esac
  case "$limit" in ''|*[!0-9]*|0) die "--limit must be a positive integer" ;; esac
  [ "$limit" -le "$TICKETS_MAX" ] || limit=$TICKETS_MAX
  local snap
  snap=$("$SCRIPT_DIR/jg-fleet-snapshot.sh" --json) || { echo "juggernaut-axi: fleet snapshot failed" >&2; exit 1; }
  printf '%s\n' "$snap" | jq_or_die tickets --arg state "$state" --arg repo "$repo" --argjson limit "$limit" '
    [.backlog.records[] | select(.structured)
     | select($state == "" or .state == $state) | select($repo == "" or .repo == $repo)] as $all
    | {schema: "juggernaut-axi.v1", view: "tickets", home: (.jg_home | split("/") | .[-2:] | join("/")), generated,
       count: ($all | length),
       tickets: [$all[:$limit][] | {id, title, state, repo, kind, blocked_by: (.unresolved_blocker_ids | join(" "))}],
       omitted: (if ($all | length) > $limit then [{surface: "tickets beyond limit", count: (($all | length) - $limit), reveal: "--limit <n> (at most 100)"}] else [] end)}'
}

backlog_snapshot() {  # prints the fleet snapshot JSON, or exits 1 naming the failure
  "$SCRIPT_DIR/jg-fleet-snapshot.sh" --json || { echo "juggernaut-axi: fleet snapshot failed" >&2; exit 1; }
}

# jq helpers shared by the backlog views: the cut that names the full length, and task-id shape.
# shellcheck disable=SC2016
TASK_JQ_DEFS='
  def dash: if . == null or . == "" then "-" else . end;
  def cut($n): tostring | length as $len
    | if ($full | not) and $len > $n then .[:$n] + "... (truncated, \($len) chars total - use --full)" else . end;
  def blocked: (.unresolved_blocker_ids | length) > 0;
  def held: .hold_kind != null;
  def cell($name): {
    priority: (.priority | dash), since: (.since | dash), blocked_by: ((.unresolved_blocker_ids | join(" ")) | dash),
    hold_kind: (.hold_kind | dash), hold_reason: ((.hold_reason | dash) | cut(100)), hold_until: (.hold_until | dash),
    pr: (.pr_url | dash), links: (((.links // []) | join(" ")) | dash)}[$name];
'

cmd_tasks() {
  local sub=list
  case "${1:-}" in list|show|ready) sub=$1; shift ;; esac
  "cmd_tasks_$sub" "$@"
}

cmd_tasks_list() {
  local state="" repo="" kind="" blocked=false limit=50 fields="" full=false
  while [ $# -gt 0 ]; do
    case "$1" in
      --state) [ $# -ge 2 ] || die "--state needs a value"; state=$2; shift ;;
      --repo) [ $# -ge 2 ] || die "--repo needs a value"; repo=$2; shift ;;
      --kind) [ $# -ge 2 ] || die "--kind needs a value"; kind=$2; shift ;;
      --blocked) blocked=true ;;
      --limit) [ $# -ge 2 ] || die "--limit needs a value"; limit=$(limit_arg "$2") || exit $?; shift ;;
      --fields) [ $# -ge 2 ] || die "--fields needs a value"; fields=$2; shift ;;
      --full) full=true ;;
      *) die "unknown tasks argument: $1" ;;
    esac
    shift
  done
  case "$state" in ''|queued|in_flight|done|held) ;; *) die "--state must be queued, in_flight, done, or held" ;; esac
  local f
  for f in ${fields//,/ }; do
    case " $TASKS_FIELDS " in *" $f "*) ;; *) die "unknown --fields name: $f (extra: ${TASKS_FIELDS// /, })" ;; esac
  done
  backlog_snapshot | jq_or_die tasks --arg state "$state" --arg repo "$repo" --arg kind "$kind" --argjson blocked "$blocked" \
    --argjson limit "$limit" --arg fields "$fields" --argjson full "$full" "$TASK_JQ_DEFS"'
    ($fields | split(",") | map(select(. != ""))) as $extra
    | [.backlog.records[] | select(.structured)
       | select($state == "" or (if $state == "held" then held else .state == $state end))
       | select($repo == "" or .repo == $repo) | select($kind == "" or .kind == $kind)
       | select(($blocked | not) or blocked)] as $all
    | {schema: "juggernaut-axi.v1", view: "tasks", home: (.jg_home | split("/") | .[-2:] | join("/")), generated,
       count: ($all[:$limit] | length), total: ($all | length),
       tasks: [$all[:$limit][] | . as $t
         | {id, state, kind, repo: (.repo | dash), title: (.title | cut(90))}
         + ([$extra[] | . as $n | {key: $n, value: ($t | cell($n))}] | from_entries)],
       omitted: (if ($all | length) > $limit then [{surface: "tasks beyond limit", count: (($all | length) - $limit), reveal: "--limit <n> (at most 100)"}] else [] end),
       help: ["Run `juggernaut-axi tasks show <id>` for one task in full",
              "Run `juggernaut-axi tasks ready` to see unblocked queued work"]}'
}

cmd_tasks_show() {
  local id="" full=false
  while [ $# -gt 0 ]; do
    case "$1" in
      --full) full=true ;;
      -*) die "unknown tasks show argument: $1" ;;
      *) [ -z "$id" ] || die "tasks show takes one task id"; id=$1 ;;
    esac
    shift
  done
  [ -n "$id" ] || die "tasks show needs a task id"
  known_task_id "$id"
  local snap
  snap=$(backlog_snapshot) || exit $?
  printf '%s\n' "$snap" | jq -e --arg id "$id" '[.backlog.records[] | select(.structured and .id == $id)] | length > 0' >/dev/null \
    || die "unknown task: $id"
  printf '%s\n' "$snap" | jq_or_die "tasks show" --arg id "$id" --argjson full "$full" "$TASK_JQ_DEFS"'
    ([.backlog.records[] | select(.structured and .id == $id)] | first) as $t
    | {schema: "juggernaut-axi.v1", view: "task", home: (.jg_home | split("/") | .[-2:] | join("/")), generated,
       task: ($t | {id, title, state, blocked: (if blocked then "yes" else "no" end),
                    blocked_by: ((.unresolved_blocker_ids | join(" ")) | dash),
                    held: (if held then "yes" else "no" end),
                    hold_kind: (.hold_kind | dash), hold_bucket: (.hold_bucket | dash), hold_reason: (.hold_reason | dash),
                    hold_until: (.hold_until | dash), kind, repo: (.repo | dash), priority: (.priority | dash),
                    since: (.since | dash), pr: (.pr_url | dash), links: (((.links // []) | join(" ")) | dash),
                    body: (((.body_lines // []) | join("\n")) | dash | cut(500))}),
       help: ["Run `juggernaut-axi tasks ready` to see unblocked queued work"]}'
}

cmd_tasks_ready() {
  local repo="" limit=50 full=false
  while [ $# -gt 0 ]; do
    case "$1" in
      --repo) [ $# -ge 2 ] || die "--repo needs a value"; repo=$2; shift ;;
      --limit) [ $# -ge 2 ] || die "--limit needs a value"; limit=$(limit_arg "$2") || exit $?; shift ;;
      --full) full=true ;;
      *) die "unknown tasks ready argument: $1" ;;
    esac
    shift
  done
  backlog_snapshot | jq_or_die "tasks ready" --arg repo "$repo" --argjson limit "$limit" --argjson full "$full" "$TASK_JQ_DEFS"'
    [.backlog.records[] | select(.structured and .state == "queued" and (blocked | not) and (held | not))
     | select($repo == "" or .repo == $repo)] as $all
    | {schema: "juggernaut-axi.v1", view: "ready", home: (.jg_home | split("/") | .[-2:] | join("/")), generated,
       count: ($all[:$limit] | length), total: ($all | length),
       ready: [$all[:$limit][] | {id, state, kind, repo: (.repo | dash), title: (.title | cut(90))}],
       omitted: (if ($all | length) > $limit then [{surface: "ready tasks beyond limit", count: (($all | length) - $limit), reveal: "--limit <n> (at most 100)"}] else [] end),
       help: ["Run `juggernaut-axi tasks show <id>` for one task in full"]}'
}

cmd_holds() {
  local kind="" bucket="" limit=50 full=false
  while [ $# -gt 0 ]; do
    case "$1" in
      --kind) [ $# -ge 2 ] || die "--kind needs a value"; kind=$2; shift ;;
      --bucket) [ $# -ge 2 ] || die "--bucket needs a value"; bucket=$2; shift ;;
      --limit) [ $# -ge 2 ] || die "--limit needs a value"; limit=$(limit_arg "$2") || exit $?; shift ;;
      --full) full=true ;;
      *) die "unknown holds argument: $1" ;;
    esac
    shift
  done
  case "$kind" in ''|captain|future|parked|external) ;; *) die "--kind must be captain, future, parked, or external" ;; esac
  case "$bucket" in ''|live|dated|aged|blocked) ;; *) die "--bucket must be live, dated, aged, or blocked" ;; esac
  backlog_snapshot | jq_or_die holds --arg kind "$kind" --arg bucket "$bucket" --argjson limit "$limit" --argjson full "$full" "$TASK_JQ_DEFS"'
    [.backlog.records[] | select(.structured and held and .state != "done")
     | select($kind == "" or .hold_kind == $kind) | select($bucket == "" or .hold_bucket == $bucket)] as $all
    | {schema: "juggernaut-axi.v1", view: "holds", home: (.jg_home | split("/") | .[-2:] | join("/")), generated,
       count: ($all[:$limit] | length), total: ($all | length),
       kinds: ($all | group_by(.hold_kind) | map({kind: .[0].hold_kind, count: length})),
       holds: [$all[:$limit][] | {id, kind: .hold_kind, bucket: (.hold_bucket | dash), age_days: (.hold_age_days // "-"),
                                  until: (.hold_until | dash), reason: ((.hold_reason | dash) | cut(100))}],
       omitted: (if ($all | length) > $limit then [{surface: "holds beyond limit", count: (($all | length) - $limit), reveal: "--limit <n> (at most 100)"}] else [] end),
       help: ["Run `juggernaut-axi tasks show <id>` for a held task in full",
              "Only a captain hold in the live bucket waits on the captain now"]}'
}

cmd_pr() {
  [ $# -eq 1 ] || die "pr takes one GitHub pull-request URL"
  case "$1" in https://github.com/*/*/pull/[0-9]*) ;; *) die "pr needs a GitHub pull-request URL" ;; esac
  case "$1" in *[[:space:]]*|*[!A-Za-z0-9._/:-]*) die "pr needs a GitHub pull-request URL" ;; esac
  local url=$1 blockers wait
  blockers=$("$SCRIPT_DIR/jg-pr-state.sh" "$url") || { echo "juggernaut-axi: could not read $url" >&2; exit 1; }
  wait=$("$SCRIPT_DIR/jg-pr-state.sh" --waiting-for "$url") || { echo "juggernaut-axi: could not read $url" >&2; exit 1; }
  jq -n --arg url "$url" --arg blockers "$blockers" --arg wait "$wait" '
    {schema: "juggernaut-axi.v1", view: "pr", url: $url,
     waiting_for: ($wait | sub("^juggernaut/waiting-for: "; "") | if . == "" then "nothing" else . end),
     count: ($blockers | split("\n") | map(select(. != "")) | length),
     blockers: [$blockers | split("\n")[] | select(. != "") | (capture("^(?<kind>[^:]+): (?<detail>.*)$") // {kind: "NOTE", detail: .})],
     note: "No blocker listed is not a readiness verdict: a required check that has not reported cannot be listed.",
     help: ["Run `juggernaut-axi tasks show <id>` for the task this pull request serves"]}' \
    || { echo "juggernaut-axi: pr result unreadable" >&2; exit 1; }
}

cmd_decisions() {
  local snap
  snap=$("$SCRIPT_DIR/jg-bearings-snapshot.sh" --json) || { echo "juggernaut-axi: fleet snapshot failed" >&2; exit 1; }
  printf '%s\n' "$snap" | jq_or_die decisions '{
    schema: "juggernaut-axi.v1", view: "decisions", home, generated,
    count: (.decisions_open | length),
    decisions: [.decisions_open[] | {id, key, verb, summary, owner}],
    omitted: [.omitted[] | select(.surface | test("decision|hold"; "i"))]}'
}

cmd_messages() {
  local task="" limit=20 f seq at body rows="" n
  while [ $# -gt 0 ]; do
    case "$1" in
      --limit) [ $# -ge 2 ] || die "--limit needs a value"; limit=$2; shift ;;
      -*) die "unknown messages argument: $1" ;;
      *) [ -z "$task" ] || die "messages takes one task id"; task=$1 ;;
    esac
    shift
  done
  [ -n "$task" ] || die "messages needs a task id"
  case "$task" in [A-Za-z0-9]*) ;; *) die "invalid task id" ;; esac
  case "$task" in *[!A-Za-z0-9._-]*) die "invalid task id" ;; esac
  case "$limit" in ''|*[!0-9]*|0) die "--limit must be a positive integer" ;; esac
  [ "$limit" -le "$TICKETS_MAX" ] || limit=$TICKETS_MAX
  local dir hdir
  dir=$(jg_task_inbox_dir "$STATE" "$task"); hdir=$(jg_task_inbox_handled_dir "$STATE" "$task")
  [ -d "$dir" ] || [ -e "$STATE/$task.meta" ] || die "unknown task: $task"
  local files
  files=$(for f in "$dir"/*.msg "$hdir"/*.msg; do
    [ -f "$f" ] && seq=$(jg_task_inbox_seq_of "${f##*/}") && printf '%s\t%s\n' "$seq" "$f"
  done | sort -n)
  n=$(printf '%s' "$files" | grep -c . || true)
  while IFS=$'\t' read -r seq f; do
    [ -n "$f" ] || continue
    at=$(sed -n 's/^at=//p;/^--$/q' "$f" | head -n1)
    body=$(jg_task_inbox_body "$f" | head -c "$MESSAGE_BYTES")
    rows+=$(jq -nc --argjson id "$seq" --arg at "$at" --arg state "$([ "${f%/*}" = "$hdir" ] && echo handled || echo pending)" \
      --arg body "$body" --argjson cut "$([ "$(wc -c < "$f")" -gt $((MESSAGE_BYTES + 200)) ] && echo true || echo false)" \
      '{id: $id, at: $at, state: $state, body: $body, truncated: $cut}')$'\n'
  done < <(printf '%s\n' "$files" | tail -n "$limit")
  printf '%s' "$rows" | jq_or_die messages -s --arg task "$task" --argjson total "$n" --argjson limit "$limit" '
    {schema: "juggernaut-axi.v1", view: "messages", task: $task, count: $total, messages: .,
     omitted: (if $total > $limit then [{surface: "older messages", count: ($total - $limit), reveal: "--limit <n> (at most 100)"}] else [] end)}'
}

write_result() {  # <action> <task> <confirmed true|false> <note>
  jq -nc --arg action "$1" --arg task "$2" --argjson confirmed "$3" --arg note "$4" \
    '{schema: "juggernaut-axi.v1", view: "write", action: $action, task: $task, ok: true, confirmed: $confirmed, note: $note}'
}

known_task_id() {  # <id> - shape only; callers prove the task exists
  case "$1" in ""|[!A-Za-z0-9]*|*[!A-Za-z0-9._-]*) die "invalid task id" ;; esac
}

cmd_answer() {
  local task="" text="" mode="" f
  while [ $# -gt 0 ]; do
    case "$1" in
      --release) mode=--release ;;
      -*) die "unknown answer argument: $1" ;;
      *) if [ -z "$task" ]; then task=$1; elif [ -z "$text" ]; then text=$1; else die "answer takes a task id and one answer"; fi ;;
    esac
    shift
  done
  known_task_id "$task"
  [ -n "$text" ] || die "answer needs the answer text"
  [ "$(printf '%s' "$text" | wc -c)" -le 8192 ] || die "answer is over 8192 bytes"
  "$HOME_ROOT/bin/jg-captain-hold.sh" open "$task" >/dev/null || die "$task is not an open captain decision"
  f=$(mktemp) || exit 1
  printf '%s\n' "$text" > "$f"
  "$HOME_ROOT/bin/jg-captain-hold.sh" answer "$task" --decision-file "$f" ${mode:+"$mode"} >&2
  local rc=$?
  rm -f -- "$f"
  [ "$rc" -eq 0 ] || exit "$rc"
  if "$HOME_ROOT/bin/jg-captain-hold.sh" answered "$task"; then
    write_result answer "$task" true "answer recorded by jg-captain-hold.sh"
  else
    write_result answer "$task" false "answer accepted but the durable record does not confirm it yet"
  fi
}

cmd_message() {
  local task="" text=""
  [ $# -eq 2 ] || die "message takes a task id and the text"
  task=$1; text=$2
  known_task_id "$task"
  [ -e "$STATE/$task.meta" ] || die "unknown task: $task"
  [ -n "${text//[[:space:]]/}" ] || die "message text is empty"
  [ "$(printf '%s' "$text" | wc -c)" -le "$MESSAGE_BYTES" ] || die "message is over $MESSAGE_BYTES bytes"
  case "$text" in /*|\$*) die "message must not start with / or $ (those reach the terminal, not the inbox)" ;; esac
  JG_HOME=${JG_HOME:-$HOME_ROOT} "$HOME_ROOT/bin/jg-send.sh" "$task" "$text" >&2 || exit $?
  write_result message "$task" true "steering record written; the worker acting on it is not confirmed"
}

cmd_ticket() {
  local title="" args=() out
  while [ $# -gt 0 ]; do
    case "$1" in
      --repo|--kind|--priority) [ $# -ge 2 ] || die "$1 needs a value"; args+=("$1" "$2"); shift ;;
      --why) [ $# -ge 2 ] || die "$1 needs a value"; args+=(--body "$2"); shift ;;
      -*) die "unknown ticket argument: $1" ;;
      *) [ -z "$title" ] || die "ticket takes one title"; title=$1 ;;
    esac
    shift
  done
  [ -n "$title" ] || die "ticket needs a title"
  local i
  for ((i = 0; i < ${#args[@]}; i += 2)); do
    case "${args[i]}:${args[i+1]}" in
      --kind:ship|--kind:scout|--kind:docs) ;;
      --kind:*) die "--kind must be ship, scout, or docs" ;;
      --priority:[0-3]) ;;
      --priority:*) die "--priority must be 0-3" ;;
    esac
  done
  out=$(JG_HOME=${JG_HOME:-$HOME_ROOT} "$HOME_ROOT/bin/jg-tasks-axi.sh" add --mint "$title" "${args[@]}" --json) || exit $?
  printf '%s\n' "$out" | jq -c '{schema: "juggernaut-axi.v1", view: "write", action: "ticket", task: .task.id, ok: .ok, confirmed: (.task.state == "queued"), note: "queued by the backlog", ticket: (.task | {id, title, state, repo, kind})}' \
    || { echo "juggernaut-axi: ticket result unreadable" >&2; exit 1; }
}

case "${1:-}" in
  -h|--help|help|"") usage; [ -n "${1:-}" ] || exit 2; exit 0 ;;
  --version) echo "juggernaut-axi $VERSION"; exit 0 ;;
  serve) shift; JUGGERNAUT_AXI_HOME=${JG_HOME:-$HOME_ROOT} exec python3 "$SCRIPT_DIR/juggernaut-axi-serve.py" "$@" ;;
esac
CMD=$1; shift
FORMAT=toon
ARGS=()
for a in "$@"; do
  case "$a" in --json) FORMAT=json ;; *) ARGS+=("$a") ;; esac
done
case "$CMD" in
  status|lanes|wakes|tickets|tasks|holds|pr|decisions|messages|answer|message|ticket) ;;
  *) die "unknown command: $CMD (try --help)" ;;
esac
for a in "${ARGS[@]+"${ARGS[@]}"}"; do
  case "$a" in -h|--help) verb_help "$CMD"; exit 0 ;; esac
done
MODEL=$("cmd_$CMD" "${ARGS[@]+"${ARGS[@]}"}") || exit $?
if [ "$FORMAT" = json ]; then
  printf '%s\n' "$MODEL"
else
  printf '%s\n' "$MODEL" | jq -c "$TOON_PREP" | jq -r "$JG_TOON_JQ" || { echo "juggernaut-axi: TOON rendering failed" >&2; exit 1; }
fi
