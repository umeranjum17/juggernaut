# Hard speed limits, in seconds, enforced by bin/jg-test-run.sh.
#
# A test that runs over its limit fails and names the time it measured. The
# class comes from the test's own name: anything ending -e2e.test.sh is an
# end-to-end test, everything else is a unit or policy test.
#
# The nightly .github/workflows/behavior.yml enforces these. The pre-merge path
# (bin/jg-local-suite.sh, and so bin/jg-ship-local.sh) only reports them, because
# a pre-merge failure would refuse every merge until the whole slow list is
# empty, which is the opposite of a fast merge.
#
# gate_wall_seconds and nightly_wall_seconds are whole-run budgets, passed to
# the runner as --max-wall-ms.
e2e_seconds=60
unit_seconds=5
gate_wall_seconds=600
nightly_wall_seconds=1800
