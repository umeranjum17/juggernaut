# Wake urgency routing: which events wake the model at once, which wait for the next
# turn, and which are only recorded. bin/jg-wake-lib.sh reads it; config/wake-routing
# overrides this file in a home and JG_WAKE_ROUTING overrides both.
#   now     wakes on its own: a captain decision, security, a failed release, a stuck
#           worker past its threshold, a finished task.
#   batch   a durable row that does not wake on its own: it arrives with the next wake of
#           any kind or with the watcher's resurface cadence, so routine events cost one
#           turn between them and none is dropped.
#   silent  recorded only; bin/jg-wake.sh settled reads it.
# A rule is `<class> <kind> <key-glob> <payload-glob>`; the first match wins. kind is
# signal, stale, check, heartbeat, or `*`. A `<task>.status` event is matched against the
# newest line of its status file, so a home rule can hold a routine state word, e.g.
# `batch signal *.status working*`; any other event is matched against its payload. No
# match means `now`, so a missing rule file hides nothing.
set re-alert-minutes 30
# A settled wake is recorded, never queued. Past this many settled wakes in one hour the
# next ones ride the digest as `batch`, so a flood is never hidden. 0 turns the cap off.
set silence-cap-per-hour 30
# How long Main's own restart pass counts as the cause of a relaunch notice.
set restart-pass-seconds 600
# The batched digest: routine (`batch`) rows are held and released as ONE wake when either trigger
# fires first. digest-count: that many routine rows have queued since the last digest (0 turns this
# trigger off). digest-minutes: the longest a routine event waits for a model turn (0 turns the whole
# digest off, and routine rows then wait for the next wake of any kind). Urgent classes (`now`: captain
# inbox, failed, blocked, needs-decision, done, security, stale escalation) never wait for either.
set digest-count 5
set digest-minutes 15
# A fleet-heartbeat gap with ready work and free lanes rides the digest until it has stayed open
# this many seconds; past that it is a real gap and wakes at once.
set gap-wake-seconds 3600
# How long after a lead's own restart (Main's restart pass or the watcher's relaunch) the
# notices that restart causes count as noise.
set lead-restart-grace-seconds 300

# class  kind    key              payload
# A squad_lead's status log is a relay channel for its child work, not a record of its
# own completion, so its `done` lines report a child's outcome and are routine. They ride
# the digest: the parent-channel libraries alone write these reserved keys
# (bin/jg-pr-check.sh's child-pr-, bin/jg-inactive-reconcile.sh's child-outcome-,
# bin/jg-merge-outcome-lib.sh's merged-), so no worker's own `done` can match them, and a
# `failed` child line keeps waking. The `[at=]` stamp sits after the key tag, so the glob
# cannot anchor on the colon.
batch    signal  *.status         done*key=child-pr-*
batch    signal  *.status         done*key=child-outcome-*
batch    signal  *.status         done*key=merged-*
now      *       *                needs-decision*
now      *       *                failed*
now      *       *                blocked*
# A ship's PR-ready report, when the task record names that PR and core/merge-on-green will
# merge it with no model turn (yolo=on or merge=approved), asks the lead for nothing: it is
# recorded, and the watcher's own merge (its `done: merged` line) or refusal alert wakes the
# lead. No recorded PR, a PR the watcher does not own, a Recon result and every other done line
# keep the row below.
silent@merge-owned signal  *.status         done*: PR *
now      check   *merge-on-green.check.sh   *NOT merging*
now      *       *                done*
batch    signal  *.turn-ended     *
batch    check   merged-*         *
# A board ask that carries no must category is a rule failure, not an alarm: the
# gate routes it to Overwatch and Main answers it there, so it rides the next
# digest instead of waking a model of its own. The two board-gate reports that do
# need a model keep the default: a merge with no proof, and a must ask waiting
# over 48 hours.
now      check   *board-gate.check.sh   *merge landed with no board Evidence card*
now      check   *board-gate.check.sh   *must ask waiting over 48h*
batch    check   *board-gate.check.sh   *board ask*
batch    check   *dpr-green*      *
batch    check   post-merge-ci-*  *
# The tickets checks report board bookkeeping and never ask the captain anything:
# a board row the work has already settled, or a pass summary, is not a decision.
# bin/jg-ticket.sh writes the state where the work happens, so the check that
# reports any remainder rides the next digest instead of waking a model.
# The route-chain probe prints a line only when a route moved or went down or up, so each line
# is news and wakes at once; any other output from it (an error) rides the digest.
now      check   *route-chain.check.sh      *route-chain: head=*
batch    check   *route-chain.check.sh      *
batch    check   *tickets-stale.check.sh    *
batch    check   *tickets-sync.check.sh     *
# Wakes that need no model (a class may carry `@condition`; bin/jg-wake-lib.sh owns them):
# a paused home answering a pause, the relaunch Main's own restart pass caused, a
# timer on a paused home, and a re-arm that finds nothing waiting for a turn.
silent@parked        signal  *.status         paused*
silent@parked        check   *                *waiting-state*
silent@restart-pass  check   squad-lead-relaunch-*   *auto-relaunched*
# During a restart pass a relaunch can lose the race to another spawn for the same lead: the
# restart is already being done, so the loser's notice is noise. Outside a pass it keeps waking.
silent@restart-pass  check   squad-lead-relaunch-*   *auto-relaunch failed*another spawn is already creating task*
silent@queue-quiet   check   rearm-resurface  *
# A doorbell the watcher deferred because the worker's turn is still running lands by itself
# when the turn ends; the watcher says so in its own words. A doorbell that is still
# unhandled with an idle pane, or a dead endpoint, keeps the default and wakes a model.
silent   stale   *                *unread juggernaut instruction*no interrupt is needed unless the worker is wedged*
# The fleet heartbeat repeats facts other owners already carry. A stall and a finished
# lane nobody closed keep waking. A gap that is only open waits (the wait timers
# escalate those themselves) is settled. A gap with ready work and free lanes is
# the ready-work check's fact, and a recovery asks for nothing, so both ride the digest.
now      check   *fleet-heartbeat.check.sh   *STALLED*
now      check   *fleet-heartbeat.check.sh   *still open - land it*
now@gap-long check *fleet-heartbeat.check.sh   *GAP for*ready*lanes working*
batch    check   *fleet-heartbeat.check.sh   *GAP for*ready*lanes working*
silent   check   *fleet-heartbeat.check.sh   *GAP for*climbing their ladder*
batch    check   *fleet-heartbeat.check.sh   *GAP for*
batch    check   *fleet-heartbeat.check.sh   *again*
# The fleet-pulse 2-hour report is a trend summary; its own words (STALLED, failed) describe
# other owners' alarms, so it rides the digest whatever it says. Other fleet-pulse checks keep
# the ordinary rules.
batch    check   *fleet-pulse.check.sh      *fleet-pulse 2h*
# A status line that reports progress or a closed question asks Main for nothing: the
# decision, blocker, failure and done lines above keep waking, and a stuck worker is a
# `stale` event. A declared pause is a wait the wait timers already own.
batch    signal  *.status         working*
batch    signal  *.status         resolved*
batch    signal  *.status         paused*
# A declared-pause timer that fires at the owning lead (a blocker keeps waking) and a worker's declared pause that is only
# being rechecked are waits the timers already own; each escalates by itself to Main
# (`level=main`) or to a stale wake when the pause is wedged or its clearing time passed.
batch    check   waiting-timer-*  *(paused,*owning lead must recheck*
batch    stale   *                *paused*declared pause, rechecked on a long cadence not a wedge*
# A pause that names the future event it waits for (`until <time>`) is a planned wait: while that
# time is ahead it rides the digest. Once the declared time has passed, the stale wake below keeps
# waking, and a `blocked` wait that names no clearing condition always wakes.
batch    stale   *                *paused*the declared time is beyond the recheck cadence*
# A lead that was told to re-arm right after its own restart reports it the same way a relaunch
# does, so for a short grace window after that restart the notice is noise; a lead still without
# supervision after the window keeps waking.
silent@lead-restarted check  squad-lead-supervision-*   *supervision not running*
# The sentinel's "watcher beacon old" doorbell is typed into the primary's pane. While a
# live watcher still holds the watcher lock, the beacon is only its predecessor's, so the
# doorbell settles; with no live watcher it keeps waking.
silent@watcher-alive check   sentinel-beacon-old   *beacon*old*
# A finished or blocked deliverable: ready, PR ready, and any status line the rows above did not call routine.
now      signal  *.status         ready*
now      signal  *.status         *PR ready*
now      signal  *.status         *
# The digest wake itself, and the five reasons to wake at once beyond the status words above.
now      check   wake-digest      *
# A captain answer: a note the captain left in the inbox, and mail addressed to this home.
now      check   inbox:*          *
now      check   mail:*           *
now      check   captain-*        *
# A red gate: any check that reports a failure (a red CI run says failed).
now      check   *                *failed*
now      check   *                *FAILED*
# A host alarm: memory, the delete guard, a model outage, a lost host, an unauthenticated
# state check, and the network check when it found something actionable.
now      check   host-memory      *
now      check   delete-guard     *
now      check   model-outage-*   *
now      check   supervision-host-return:*   *
now      check   unauthenticated-state-checks   *
now      check   *key-in-env-check.check.sh   *
now      check   startup*         *
now      check   sentinel-*       *
# A worker stuck past its ladder: every stale event, and the stall, owner and escalation checks.
now      stale   *                *
now      check   *-stall          *
now      check   *migration-watch.check.sh   *no status chang*
now      check   waiting-timer-*  *
now      check   *-owner          *
now      check   *-escalation     *
# A lead that died or lost its supervision: the rows above settle only the ones Main's own restart caused.
now      check   squad-lead-relaunch-*       *
now      check   squad-lead-supervision-*    *
# A re-arm that finds an urgent row waiting for a turn (the quiet case is settled above).
now      check   rearm-resurface  *
# A result an adapter owns (Relay, process-to-event) is routed to that adapter, not delayed.
now      check   procevent:*      *
# A heartbeat over a fleet that did not change since the last one that woke asks for nothing.
silent@fleet-unchanged heartbeat *  *
now      heartbeat *              *
# Everything else is routine and rides the digest. Nothing is dropped: the row stays queued.
batch    *       *                *
