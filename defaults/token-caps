# Byte caps for the session-start digest, read by bin/jg-session-start.sh.
#
# One `<name> <positive integer>` per line. A home overrides a value in
# config/token-caps (same format); a JG_SESSION_START_* or JG_DIGEST_* variable
# overrides both for one run. A missing, zero or malformed value falls back to the
# built-in in the script, so a bad line can never switch a cap off.
#
# Every cap cuts only what the digest PRINTS. Nothing is deleted from disk, and each
# cut ends in the section's total count and the one command (or sed range) that
# prints all of it. A cut section lists its newest and most urgent items first, so
# what a session needs to act on is never the part cut. No cap touches the lock, the
# wake queue and its acknowledgement line, the supervision block or the network
# checks: those carry an action and print whole.
#
# Measured on 2026-11-09 with bin/jg-session-start.sh on a copy of each home's start
# inputs: the main home's digest was 299,922 bytes and a Squad Lead home's was 223,722
# (the curated files 144 KB, the lane rows 105 KB, the backlog 68 KB). A fresh session
# has to start under 20 percent of a 200K-token window; 40,000 bytes is about 10,000
# tokens, 5 percent.

# The whole digest, in bytes. Every byte the digest prints is counted against it, and a
# section prints only what is left of it when it runs.
digest-cap 40000

# Bytes kept free for what prints last (the network checks and the next-step note), so
# no bulky section can crowd them out.
digest-reserve 2500

# The backlog listing: the four groups (in flight, held, blocked, ready) share it.
backlog-cap 5000

# The lane rows (one per worker lane, finished lanes last).
lanes-cap 6000

# Orphan status logs, public commitments.
orphan-cap 600
commitments-cap 2500

# Heading index for the learnings file and for a long owner-rules file, each.
index-cap 1500

# Owner rules: printed whole up to this size, else as an index of every rule's title.
owner-rules-cap 2500

# Bytes of the opening lines printed for data/projects.md, data/squad_leads.md and
# data/captain.md.
context-file-cap 1500

# Bytes of the opening lines printed for data/captain-shared.md and data/learnings.md
# (the learnings file adds its heading index on top).
memory-file-cap 1200

# Status lines kept per lane row. Reason: a status line is a wake event, not
# current state; bin/jg-crew-state.sh answers current state.
status-tail 1

# Context ceilings, one number per role and item, read by bin/jg-context-load.sh (its `check` runs in
# tests/jg-context-budget.test.sh and once a day in bin/jg-startup-growth-check.sh). Source:
# data/fable-thin-context/report.md sections 6.2 and 8.3 (row 61). Each line lands at today's value, so
# the check is green on today's tree; the slice that lowers a number lowers its own line in its own
# commit. The unit is B (bytes) or tok (tokens). A line whose item the tree measures (the two contract
# lines) is measured at each check; every other is a reading: the newest row of data/context-load.tsv.
# A reading is a median or one lane, not a sum, so a line holds the reading and is never a target.
#
# B   AGENTS.md of a session of this repository (today's tree; the report read 43,367)
ctx-agents-md 44058
# B   what a supervisor loads as its role contract: the same file until TC4b moves it
ctx-supervisor-contract 44058
# B   tool schemas of a worker's first request
ctx-worker-tool-schemas 66818
# B   skill listing of a worker
ctx-worker-skill-listing 30174
# B   launch brief and the rules it reads at start: the median. bin/jg-brief-lint.sh reports one brief
#     over this line (its old 16,000 line never held a brief; the median was 33,965)
ctx-worker-brief 33965
# B   static part of the supervision block, Claude Code primary with the host on (TC7 holds it here)
ctx-supervisor-supervision-static 8466
# B   memory index of another home, read by a lead or a worker
ctx-lead-memory-index 25026
# tok first model call of a worker, and of a lead after a compaction
ctx-worker-first-call 64731
ctx-lead-first-call 97147
