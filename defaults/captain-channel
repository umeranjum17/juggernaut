# Captain channel routing: how the captain hears about a change of state.
# bin/jg-bus.sh is the one reader; a home's config/captain-channel overrides any single key
# here, and JG_CAPTAIN_CHANNEL overrides both files.
#
# A captain-facing change of state is recorded, then sent through the chat in-process.
#   mode          direct  record it, then send it through the chat in-process (the shipped value).
#                 off     do nothing at all.
#   subject-prefix  the name every recorded event carries before its kind.
set mode direct
set subject-prefix jg.captain
# Chat gateway (jg-bus gateway, docs/captain-chat.md). Optional: with no token file at the path
# below (mode 600) it is off, silently. `jg-bus gateway setup` guides you through making your own
# bot, storing its token and pairing; `jg-bus gateway pair` alone sets telegram-allow-user.
#   set gateway-adapters telegram
#   set telegram-token-file config/captain-chat/telegram.token
#   set chat-media-days 30       # inbound chat files are kept this many days, then deleted
#   set chat-transcribe-timeout 120      # seconds before a voice note's transcript is given up (engine: bin/jg-chat-transcribe.sh setup)
#   set chat-transcribe-max-seconds 300  # a longer voice note is cut here, and the transcript line says so
#   set chat-transcribe-cmd <program>    # another engine: takes a 16 kHz wav, prints the words
