#!/usr/bin/env bash
# Repository-targeting guard: no lane creates, comments on, reviews, or pushes to a repository outside allowed-repos, the one list next to this script.
# repo-guard <gh-axi|gh> [args...] is the shim in front of that tool: a write command's target is resolved explicitly - --repo, then GH_REPO, then this clone's own origin - and never from another remote, so a fork clone can never fall back to its parent; an on-list target reaches the real tool with --repo made explicit, and an off-list one is refused.
# repo-guard pre-push <remote> <url> is the git pre-push extension: it refuses a push to a remote outside allowed-repos, while a local path or file:// remote publishes nothing.
# A refusal is final - no bypass flag, no environment skip - and it names the refused repository and the allow-listed alternative on stderr with a non-zero exit status.
set -u -o pipefail
unset CDPATH
HERE=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)
ALLOW=${REPO_GUARD_ALLOW:-$HERE/allowed-repos}
DATA=${XDG_DATA_HOME:-$HOME/.local/share}/jg-repo-guard # holds <tool>.real, the real binary's path
entries() { sed 's/[[:space:]]*$//' "$ALLOW" 2>/dev/null | grep -v '^[[:space:]]*\(#\|$\)'; }

write_command() { # <group> <verb>
  case "$1" in pr | issue | release | repo) ;; *) return 1 ;; esac
  case "$2" in
  create | comment | review | edit | merge | close | reopen | delete | ready | update-branch | revert | lock | unlock | archive | rename | transfer) return 0 ;;
  esac
  return 1
}

allowed() { # <owner/repo>: is this repository on the allow-list?
  local repo=${1,,} e
  while IFS= read -r e; do
    e=${e,,}
    case "$e" in
    *'/*') [ "${repo%%/*}" = "${e%/\*}" ] && return 0 ;;
    "$repo") return 0 ;;
    esac
  done <<<"$(entries)"
  return 1
}

refuse() { # [<repo>] <what it would do>
  local example
  example=$(entries | head -n 1)
  case "$example" in *'/*') example="${example%\/*}/name" ;; esac
  {
    if [ "$#" = 2 ]; then printf 'repo-guard: refused: %s targets %s, which is not an allowed repository.\n' "$2" "$1"
    else printf 'repo-guard: refused: %s.\n' "$1"; fi
    printf 'repo-guard: allowed (%s): %s\n' "$ALLOW" "$(entries | paste -sd ' ' -)"
    printf 'repo-guard: retry against one of those (for example --repo %s) or add it to that list. This refusal is final.\n' "$example"
  } >&2
  exit 1
}

repo_from_url() { # <git remote url>: print owner/repo; fail for a path that publishes nothing.
  local u=${1%.git} pair
  case "$u" in
  '' | /* | ./* | ../* | file://* | ~*) return 1 ;;
  *://*) u=${u#*://} u=${u#*/} ;;
  *:*) u=${u#*:} ;;
  *) return 1 ;;
  esac
  pair=$(printf '%s' "${u%/}" | awk -F/ 'NF >= 2 { print $(NF-1) "/" $NF }')
  [ -n "$pair" ] || return 1
  printf '%s' "$pair"
}

flag_repo() { # [args...]: print the --repo/-R value the caller already passed, if any.
  local prev='' a
  for a in "$@"; do
    case "$prev" in -R | --repo) printf '%s' "$a"; return 0 ;; esac
    case "$a" in
    --repo=*) printf '%s' "${a#--repo=}"; return 0 ;;
    -R) prev=$a; continue ;;
    -R*) printf '%s' "${a#-R}" | sed 's/^=//'; return 0 ;;
    esac
    prev=$a
  done
  return 1
}

gh_mode() {
  local group=${1:-} verb=${2:-} explicit='' target=''
  write_command "$group" "$verb" || exec "$REAL" "$@"
  explicit=$(flag_repo "$@" || true)
  target=${explicit:-${GH_REPO:-}}
  [ -n "$target" ] || {
    target=$(repo_from_url "$(git remote get-url origin 2>/dev/null)") ||
      refuse "this $group $verb names no repository this clone can resolve; pass --repo"
  }
  allowed "$target" || refuse "$target" "this $group $verb"
  [ -n "$explicit" ] && exec "$REAL" "$@"
  exec "$REAL" "$@" --repo "$target"
}

push_mode() {
  local url=${2:-} repo
  cat >/dev/null 2>&1 || true # drain git's ref lines so the chained hooks never see EPIPE
  [ -n "$url" ] || refuse 'the pre-push hook reported no remote url'
  repo=$(repo_from_url "$url") || {
    case "$url" in '' | /* | ./* | ../* | file://* | ~*) exit 0 ;; esac # a local remote publishes nothing
    refuse "a push to $url, which names no repository"
  }
  allowed "$repo" || refuse "$repo" 'a push'
}

case "${1:-}" in
gh-axi | gh)
  TOOL=$1
  shift
  REAL=$(cat "$DATA/$TOOL.real" 2>/dev/null || true)
  [ -n "$REAL" ] && [ -x "$REAL" ] || {
    echo "repo-guard: refused: no real $TOOL recorded in $DATA/$TOOL.real; reinstall repo-guard. This refusal is final." >&2
    exit 1
  }
  gh_mode "$@"
  ;;
pre-push) shift && push_mode "$@" ;;
*) echo 'usage: repo-guard <gh-axi|gh> [args...] | repo-guard pre-push <remote> <url>' >&2; exit 2 ;;
esac
