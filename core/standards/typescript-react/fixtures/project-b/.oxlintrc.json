{ "plugins": ["react", "typescript", "import"],
  "rules": { "no-restricted-globals": ["error", { "name": "fetch", "message": "Use the api client." }], "no-restricted-imports": ["error", { "paths": [{ "name": "react", "importNames": ["useEffect"], "message": "No useEffect." }] }],
             "typescript/no-explicit-any": "error", "typescript/no-floating-promises": "error",
             "react-hooks/exhaustive-deps": "error", "react-hooks/rules-of-hooks": "error" },
  "overrides": [ { "files": ["src/shared/api/**"], "rules": { "no-restricted-globals": "off" } } ] }
