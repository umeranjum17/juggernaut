    {
      "path": [
        "radio",
        "drain"
      ],
      "meaning": "Show the queued wakes and the notes waiting for Main; when an acknowledgement is owed, data.ack_ref holds the reference for `radio ack`.",
      "roles": [
        "overwatch"
      ],
      "args": [],
      "changes": true,
      "method": "POST",
      "form": "bin/jg-wake-drain.sh",
      "repeat_key": "none",
      "exits": {
        "0": 0,
        "1": 1,
        "2": 2
      },
      "schema": "radio.drain.v1",
      "script": "bin/jg-wake-drain.sh",
      "operation": "-",
      "aliases": [],
      "emits": "ack-ref"
    },
    {
      "path": [
        "radio",
        "ack"
      ],
      "meaning": "Acknowledge the wakes a drain showed, with the reference that drain returned; a repeat answers 'already processed'.",
      "roles": [
        "overwatch"
      ],
      "args": [
        {
          "name": "ref",
          "type": "ack-ref",
          "required": true
        },
        {
          "name": "again",
