          "required": false
        }
      ],
      "changes": true,
      "method": "POST",
      "form": "bin/jg-wake-drain.sh <ref>",
      "repeat_key": "ref",
      "exits": {
        "0": 0,
        "1": 1,
        "2": 2
      },
      "schema": "radio.ack.v1",
      "script": "bin/jg-wake-drain.sh",
      "operation": "--ack-through",
      "aliases": [],
      "next": "jg radio drain"
    },
