{
  "apiVersion": "juggernaut.dev/v1",
  "kind": "WorkflowDefinition",
  "metadata": {
    "name": "escalation-wait-timers",
    "migrationStep": "5c",
    "mode": "shadow",
    "authoritative": "bin/jg-watch.sh and core/wait-timers/bin/jg-wait-timers-lib.sh keep deciding; this definition only runs beside them",
    "reader": "bin/jg-escalation-workflows.sh is the one reader; a home may override this file at config/escalation-workflows.json or with JG_ESCALATION_WORKFLOW"
  },
  "spec": {
    "version": 1,
    "key": "waiting-timer-{home}-{task}-g{generation}-{source}",
    "sources": [
      {
        "name": "herdr-blocked",
        "facts": "agent-list",
        "note": "a blocked Herdr agent, read from the runtime's agent list; a replay cannot see it, so parity rows never carry it"
      },
      {
        "name": "prompt",
        "facts": "wait-source",
        "fresh": true
      },
      {
        "name": "question",
        "facts": "wait-source",
        "fresh": true
      },
      {
        "name": "quota",
        "facts": "wait-source",
        "fresh": true
      },
      {
        "name": "errors",
        "facts": "wait-source",
        "fresh": true
      },
      {
        "name": "silent",
        "facts": "wait-source",
        "fresh": true
      },
      {
        "name": "supervision",
        "facts": "wait-source",
        "fresh": false
      },
      {
        "name": "greenpr",
        "facts": "wait-source",
        "fresh": true
      },
      {
        "name": "decision",
        "facts": "status-open-decision"
      },
      {
        "name": "pause",
        "facts": "status-declared-wait",
        "paused": true
      }
    ],
    "timers": {
      "owner": {
        "seconds": 120,
        "env": "JG_WAIT_ALERT_SECS"
      },
      "escalate": {
        "seconds": 300,
        "env": "JG_WAIT_ESCALATE_SECS"
      },
      "card": {
        "seconds": 600,
        "env": "JG_WAIT_CARD_SECS"
      },
      "re-alert": {
        "seconds": 600,
        "env": "JG_PROMPT_REALERT_SECS"
      },
      "pause": {
        "seconds": 14400,
        "env": "JG_PAUSE_RESURFACE_SECS"
      }
    },
    "rungs": {
      "owner": {
        "deliver": "wake"
      },
      "escalate": {
        "deliver": "escalate",
        "lead": "parent-report",
        "main": "wake"
      },
      "card": {
        "deliver": "board-card",
        "actor": "main",
        "repeats": true
      },
      "re-alert": {
        "deliver": "wake",
        "repeat": true,
        "redeliver": "repeats"
      }
    },
    "ladders": {
      "wait": {
        "rungs": [
          {
            "rung": "owner",
            "timer": "owner"
          },
          {
            "rung": "escalate",
            "timer": "escalate"
          },
          {
            "rung": "card",
            "timer": "card",
            "actor": "main"
          }
        ],
        "re-alert": "re-alert"
      },
      "pause": {
        "rungs": [
          {
            "rung": "owner",
            "timer": "pause"
          }
        ],
        "re-alert": "pause"
      }
    }
  }
}
