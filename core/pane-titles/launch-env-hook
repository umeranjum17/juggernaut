#!/usr/bin/env bash
# Set a readable pane title, disable Claude's competing auto-title, and rename the current Herdr tab.
set -euo pipefail
[ "$#" -eq 1 ] || { echo 'pane-titles: expected the launch environment output path' >&2; exit 2; }
out=$1
feature=${JG_PANE_TITLES_HOME:-${XDG_DATA_HOME:-$HOME/.local/share}/jg-pane-titles}
previous=$feature/previous-launch-env-hook
tmp=$out.pane-titles.$$
trap 'rm -f -- "$tmp"' EXIT

title=''
if [ -n "${JG_TASK_ID:-}" ]; then
  id=${JG_TASK_ID//[-_]/ }
  # A title is cosmetic: every lookup failure below degrades to the task id and the launch continues.
  title=$id
  home=${JG_HOME:-}
  # jg-spawn.sh exports JG_HOME; a pane started before that (or by a server without it) still carries
  # JG_TASK_INBOX, the absolute <home>/state/<task>.inbox path, so the home resolves from there.
  if { [ -z "$home" ] || [ ! -x "$home/bin/jg-backlog.sh" ]; } && [ -n "${JG_TASK_INBOX:-}" ] && [ "$(basename -- "$(dirname -- "$JG_TASK_INBOX")")" = state ]; then
    home=$(dirname -- "$(dirname -- "$JG_TASK_INBOX")")
  fi
  if [ -z "$home" ] || [ ! -x "$home/bin/jg-backlog.sh" ]; then
    echo "pane-titles: no backlog helper under JG_HOME (${JG_HOME:-unset}); using the task id as the title" >&2
  elif ! shown=$(JG_HOME="$home" "$home/bin/jg-backlog.sh" show "$JG_TASK_ID" --full); then
    echo "pane-titles: cannot read backlog title for task $JG_TASK_ID; using the task id as the title" >&2
  elif backlog_title=$(printf '%s\n' "$shown" | sed -n 's/^  title: //p' | head -1); [ -z "$backlog_title" ]; then
    echo "pane-titles: task $JG_TASK_ID has no backlog title; using the task id as the title" >&2
  else
    title="$id: $backlog_title"
  fi
else
  home=${JG_HOME:-$(pwd -P)}
  name=''
  if [ -r "$home/data/squad_leads.md" ]; then
    name=$(awk -v home="$home" 'index($0, "(home: " home ";") { print $2; exit }' "$home/data/squad_leads.md")
  fi
  [ -n "$name" ] || name=$(basename "$home")
  name=${name//[-_]/ }
  name=${name^}
  title="$name lead"
fi
if [ -f "$previous" ]; then
  if [ -x "$previous" ]; then "$previous" "$tmp"; else bash "$previous" "$tmp"; fi || {
    echo 'pane-titles: chained launch-env-hook failed' >&2; exit 1;
  }
  IFS= read -r exports < "$tmp" || { echo 'pane-titles: chained hook wrote no export statement' >&2; exit 1; }
  [ "$(wc -l < "$tmp")" -eq 1 ] && [[ "$exports" == export\ * ]] || {
    echo 'pane-titles: chained hook must write one export statement' >&2; exit 1;
  }
  printf '%s CLAUDE_CODE_DISABLE_TERMINAL_TITLE=1\n' "$exports" > "$out"
else
  printf 'export CLAUDE_CODE_DISABLE_TERMINAL_TITLE=1\n' > "$out"
fi
# Keep the tab label and terminal title identical and bounded for Herdr's tab strip.
title=$(printf '%s' "$title" | tr -cd '[:print:]' | cut -c1-72)
if [ -n "${HERDR_SESSION:-}" ]; then
  tab_id=$(herdr --session "$HERDR_SESSION" pane current --current | jq -er '.result.pane.tab_id') || {
    echo 'pane-titles: Herdr could not identify the current pane tab' >&2; exit 1;
  }
  herdr --session "$HERDR_SESSION" tab rename "$tab_id" "$title" || {
    echo "pane-titles: Herdr could not rename tab $tab_id to '$title'" >&2; exit 1;
  }
fi
printf '\033]0;%s\007' "$title"
