#!/usr/bin/env bash
# PATH wrapper: with JG_HOME/config/account-pool, --json Claude row uses jg-model-pool's
# claude-accounts reading (same pick/floors/credits refusal). Else exec upstream.
# Env: JG_QUOTA_AXI_REAL, JG_MODEL_POOL, JG_QUOTA_AXI_POOL_UPSTREAM, JG_QUOTA_AXI_POOL_ATTEMPTED,
#      JG_QUOTA_AXI_POOL_DEPTH (set by this wrapper for the call it delegates; above 0 means go upstream).
set -euo pipefail
here=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
addons=$(cd "$here/../.." && pwd)
model_pool=${JG_MODEL_POOL:-${JG_ADDONS_DIR:-$addons}/account-pool/bin/jg-model-pool}
upstream_file=${JG_QUOTA_AXI_POOL_UPSTREAM:-${XDG_DATA_HOME:-$HOME/.local/share}/jg-quota-axi-pool/upstream}

find_upstream() {
  if [ -n "${JG_QUOTA_AXI_REAL:-}" ] && [ -x "$JG_QUOTA_AXI_REAL" ]; then printf '%s\n' "$JG_QUOTA_AXI_REAL"; return 0; fi
  if [ -r "$upstream_file" ]; then
    local s; s=$(head -n 1 "$upstream_file")
    [ -n "$s" ] && [ -x "$s" ] && { printf '%s\n' "$s"; return 0; }
  fi
  local self cand; self=$(readlink -f "$0" 2>/dev/null || printf '%s\n' "$0")
  while IFS= read -r cand; do
    [ -n "$cand" ] || continue
    [ "$(readlink -f "$cand" 2>/dev/null || printf '%s\n' "$cand")" = "$self" ] && continue
    case "$cand" in */jg-quota-axi-pool/*|*/quota-axi-pool/bin/*) continue ;; esac
    [ -x "$cand" ] || continue
    printf '%s\n' "$cand"; return 0
  done < <(type -aP quota-axi 2>/dev/null || true)
  return 1
}

want_json=0 passthru=0
for a in "$@"; do case "$a" in --json) want_json=1 ;; --version|-v|-V|--help|-h) passthru=1 ;; esac; done
upstream=$(find_upstream) || { echo "quota-axi-pool: upstream quota-axi not found (set JG_QUOTA_AXI_REAL)" >&2; exit 127; }
# Recursion guard: this wrapper answers to the name `quota-axi`, and the tool it delegates to (the
# account pick) reads quota by running `quota-axi`. One trip through the pool per call is the point;
# a call that already is one goes straight to the upstream, so a caller that asks the wrapper - the
# Claude accounts reader, an older installed copy, anything else - gets a reading instead of a loop.
depth=${JG_QUOTA_AXI_POOL_DEPTH:-0}
case "$depth" in '' | *[!0-9]*) depth=0 ;; esac
pool_config=${JG_HOME:+$JG_HOME/config/account-pool}
if [ "$passthru" = 1 ] || [ -z "${JG_HOME:-}" ] || [ "$depth" -gt 0 ]; then
  exec "$upstream" "$@"
fi
# --json: every registered Claude and Codex account from the one quota view (claude-accounts/bin/jg-quota-view),
# not the ambient login alone. Per provider with registered workers: accountKey default = the worker with the most
# room (an exhausted one when none has any), accountKey <id> = each worker, accountKey main = Main's own reserved
# login. A provider with no registered workers keeps the upstream row as its default.
quota_view=${JG_QUOTA_VIEW:-${JG_ADDONS_DIR:-$addons}/claude-accounts/bin/jg-quota-view}
if [ "$want_json" = 1 ] && [ -x "$quota_view" ]; then
  view=$("$quota_view" 2>/dev/null) || view=''
  if jq -e '[.providers[]? | .workers[]?, (.reserved // empty)] | length > 0' <<<"${view:-}" >/dev/null 2>&1; then
    base=$("$upstream" "$@" 2>/dev/null) || base=''
    jq -e 'type=="object" and (.providers|type)=="array"' <<<"${base:-}" >/dev/null 2>&1 \
      || base=$(jq -nc --arg at "$(date -u +%Y-%m-%dT%H:%M:%SZ)" '{generatedAt:$at,schemaVersion:5,providers:[]}')
    jq -c --argjson view "$view" '
      def win($id; $label; $kind; $left; $reset):
        if $left == null then empty else {id:$id,label:$label,kind:$kind,percentRemaining:$left} + (if $reset != null then {resetsAt:$reset} else {} end) end;
      def qrow($p; $key; $a; $reserved):
        {provider:$p, accountKey:$key, account:{id:$a.id,name:$a.name,reserved:$reserved}, state:{status:"fresh",stale:$a.stale},
         windows:[win("five_hour";"session";"session";$a.five_hour;$a.five_hour_resets_at), win("seven_day";"week";"weekly";$a.seven_day;$a.resets_at)]}
        + (if $a.left == null then {quotaSemantics:{status:"unknown",effectiveAvailability:[]}}
           else {quotaSemantics:{status:"known",effectiveAvailability:[{scope:"all_models",status:"known",effectivePercentRemaining:$a.left,
             runway:(if $a.left <= 0 then {status:"exhausted_now",usableRunwaySeconds:0} else {status:"through_reset"} end),
             selection:{status:"known",spendPriority:($a.left/100)}}]}} end);
      ([$view.providers | to_entries[] | select(.value.workers | length > 0) | .key]) as $multi
      | .schemaVersion = 6
      | .providers = (
          [.providers[]? | select(.provider as $p | $multi | index($p) | not) | . + {accountKey: (.accountKey // "default")}]
          + [$view.providers | to_entries[] | .key as $p | .value as $v
             | ([$v.workers[] | select(.left != null)] | sort_by(-.left) | first) as $top
             | (if $top != null then qrow($p; "default"; $top; false) else empty end),
               ($v.workers[] | qrow($p; .id; .; false)),
               ($v.reserved | select(. != null) | qrow($p; "main"; .; true))])' <<<"$base"
    exit 0
  fi
fi
[ -f "${pool_config:-}" ] && [ -x "$model_pool" ] || exec "$upstream" "$@"
JG_QUOTA_AXI_POOL_DEPTH=$((depth + 1))
export JG_QUOTA_AXI_POOL_DEPTH

attempted=${JG_QUOTA_AXI_POOL_ATTEMPTED:-[]}
case "$attempted" in \[*\]) ;; *) attempted='[]' ;; esac
req=$(jq -nc --arg p "$pool_config" --argjson a "$attempted" '{v:1,purpose:"work",pool_config:$p,capabilities:["text"],attempted:$a}')
pick=$(printf '%s' "$req" | "$model_pool" pick --json 2>/dev/null) || pick=''
jq -e '.ok == true' <<<"${pick:-}" >/dev/null 2>&1 || exec "$upstream" "$@"
pick_id=$(jq -r '.selection_id // .id // empty' <<<"$pick")
provider=$(jq -r '.provider // empty' <<<"$pick")
folder=$(jq -r '.set.CLAUDE_CONFIG_DIR // empty' <<<"$pick")

if [ "$want_json" = 0 ]; then
  if [ "$provider" = claude ] && [ -n "$folder" ] && [ -d "$folder" ]; then
    while IFS= read -r var; do
      [ -n "$var" ] || continue
      case "$var" in [A-Za-z_][A-Za-z0-9_]*) unset "$var" ;; esac
    done < <(jq -r '.unset[]? // empty' <<<"$pick")
    export CLAUDE_CONFIG_DIR=$folder
  fi
  exec "$upstream" "$@"
fi

state=
while IFS= read -r line || [ -n "$line" ]; do case "$line" in state=*) state=${line#state=} ;; esac; done <"$pool_config"
reading=
for cand in ${JG_HOME:+"$JG_HOME/state/claude-accounts.json"} ${state:+"$state/claude-accounts.json"}; do
  [ -n "${cand:-}" ] && [ -r "$cand" ] || continue
  reading=$cand; break
done
base=$("$upstream" "$@" 2>/dev/null) || base=''
jq -e 'type=="object" and (.providers|type)=="array"' <<<"${base:-}" >/dev/null 2>&1 \
  || base=$(jq -nc --arg at "$(date -u +%Y-%m-%dT%H:%M:%SZ)" '{generatedAt:$at,schemaVersion:5,providers:[]}')

unknown_row() {
  jq -nc --arg id "$1" --arg note "$2" \
    '{provider:"claude",state:{status:"fresh",stale:false},windows:[],quotaSemantics:{status:"unknown",effectiveAvailability:[]},pool:{id:$id,note:$note}}'
}

if [ "$provider" != claude ] || [ -z "$pick_id" ] || [[ $pick_id == route:* ]]; then
  claude_row=$(unknown_row "$pick_id" "jg-model-pool non-Claude fallover")
elif [ -z "$reading" ]; then
  claude_row=$(unknown_row "$pick_id" "no claude-accounts reading")
else
  claude_row=$(jq -c --arg id "$pick_id" --arg folder "$folder" '
    def through($p): if $p<=0 then {status:"exhausted_now",usableRunwaySeconds:0} else {status:"through_reset"} end;
    (.accounts//[]|map(select(.id==$id))|first) as $a |
    if $a==null then {provider:"claude",state:{status:"fresh",stale:false},windows:[],quotaSemantics:{status:"unknown",effectiveAvailability:[]},pool:{id:$id,note:"pick missing from reading"}}
    else ([$a.five_hour.left,$a.seven_day.left]|map(select(.!=null))|if length==0 then null else min end) as $r |
      if $r==null then {provider:"claude",state:{status:"fresh",stale:false},windows:[],quotaSemantics:{status:"unknown",effectiveAvailability:[]},pool:{id:$id,note:"no 5h/7d left"}}
      else {
        provider:"claude", state:{status:"fresh",stale:($a.stale==true)},
        windows:[(if $a.five_hour.left!=null then {id:"five_hour",label:"session",kind:"session",percentRemaining:$a.five_hour.left}+(if $a.five_hour.resets_at!=null then {resetsAt:$a.five_hour.resets_at} else {} end) else empty end),
                 (if $a.seven_day.left!=null then {id:"seven_day",label:"week",kind:"weekly",percentRemaining:$a.seven_day.left}+(if $a.seven_day.resets_at!=null then {resetsAt:$a.seven_day.resets_at} else {} end) else empty end)],
        quotaSemantics:{status:"known",effectiveAvailability:[{
          scope:"all_models",status:"known",effectivePercentRemaining:$r,
          boundedBy:[(if $a.five_hour.left!=null then "five_hour" else empty end),(if $a.seven_day.left!=null then "seven_day" else empty end)],
          limitingWindowIds:(if ($a.five_hour.left//999)<=($a.seven_day.left//999) then ["five_hour"] else ["seven_day"] end),
          runway:through($r), selection:{status:"known",spendPriority:($r/100)}}]},
        pool:{id:$id,folder:$folder,source:"jg-model-pool",runway:$r}
      } end
    end' "$reading")
fi
jq -c --argjson row "$claude_row" '.providers=(( [.providers[]?|select(.provider!="claude")] )+[$row])' <<<"$base"
