{
  "skillOverrides": {
    "afk": "user-invocable-only",
    "ahoy": "user-invocable-only",
    "bearings": "user-invocable-only",
    "quiet": "user-invocable-only",
    "stow": "user-invocable-only",
    "updatejuggernaut": "user-invocable-only",
    "away-quiet-supervision": "name-only",
    "decision-hold-lifecycle": "name-only",
    "firstmate-codexapp": "name-only",
    "firstmate-coding-guidelines": "name-only",
    "firstmate-orca": "name-only",
    "firstmate-self-repo": "name-only",
    "fmx-respond": "name-only",
    "secondmate-provisioning": "name-only",
    "stuck-crewmate-recovery": "name-only",
    "updatefirstmate": "name-only",
    "agent-skill-trigger-index": "name-only",
    "ask-user-authority": "name-only",
    "bootstrap-diagnostics": "name-only",
    "captain-hold-lifecycle": "name-only",
    "diagnostic-reasoning": "name-only",
    "fleet-records": "name-only",
    "harness-adapters": "name-only",
    "intel": "name-only",
    "juggernaut-coding-guidelines": "name-only",
    "juggernaut-self-repo": "name-only",
    "operational-home-layout": "name-only",
    "project-management": "name-only",
    "quota-array-dispatch": "name-only",
    "radio-silence": "name-only",
    "relay-respond": "name-only",
    "resupply": "name-only",
    "scout-completion": "name-only",
    "session-start-recovery": "name-only",
    "ship-landing": "name-only",
    "squad-lead-provisioning": "name-only",
    "stuck-operator-recovery": "name-only",
    "task-dispatch": "name-only",
    "validation-supervision": "name-only",
    "watchover": "name-only",
    "watchover-supervision": "name-only"
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -z \"${GROK_AGENT:-}${GROK_HOOK_EVENT:-}\" ] || exit 0; exec \"$CLAUDE_PROJECT_DIR\"/bin/jg-sessionstart-run.sh",
            "timeout": 180
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "[ -z \"${GROK_AGENT:-}${GROK_HOOK_EVENT:-}\" ] || exit 0; exec \"$CLAUDE_PROJECT_DIR\"/bin/jg-arm-pretool-check.sh --claude"
          },
          {
            "type": "command",
            "command": "[ -z \"${GROK_AGENT:-}${GROK_HOOK_EVENT:-}\" ] || exit 0; exec \"$CLAUDE_PROJECT_DIR\"/bin/jg-cd-pretool-check.sh --claude"
          },
          {
            "type": "command",
            "command": "[ -z \"${GROK_AGENT:-}${GROK_HOOK_EVENT:-}\" ] || exit 0; exec \"$CLAUDE_PROJECT_DIR\"/bin/jg-guard-host.sh hook"
          }
        ]
      },
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/bin/jg-subagent-pretool-check.sh --claude"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -z \"${GROK_AGENT:-}${GROK_HOOK_EVENT:-}\" ] || exit 0; exec \"$CLAUDE_PROJECT_DIR\"/bin/jg-host-mirror.sh hook claude",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "[ -z \"${GROK_AGENT:-}${GROK_HOOK_EVENT:-}\" ] || exit 0; exec \"$CLAUDE_PROJECT_DIR\"/bin/jg-overwatch-kpi.sh hook claude",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -z \"${GROK_AGENT:-}${GROK_HOOK_EVENT:-}\" ] || exit 0; exec \"$CLAUDE_PROJECT_DIR\"/bin/jg-turnend-guard.sh --claude"
          },
          {
            "type": "command",
            "command": "[ -z \"${GROK_AGENT:-}${GROK_HOOK_EVENT:-}\" ] || exit 0; exec \"$CLAUDE_PROJECT_DIR\"/bin/jg-claude-stop-autoarm.sh",
            "asyncRewake": true,
            "timeout": 28800
          },
          {
            "type": "command",
            "command": "[ -z \"${GROK_AGENT:-}${GROK_HOOK_EVENT:-}\" ] || exit 0; exec \"$CLAUDE_PROJECT_DIR\"/bin/jg-host-mirror.sh hook claude",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
